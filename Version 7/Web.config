<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <appSettings>
    <!-- V14.5 Super User recovery remains available. A reset requires the existing PBKDF2
         recovery key AND an authenticator code/unused backup code for a pre-enrolled Super User.
         HTTPS and database-backed throttling are enforced. Optional expiry/IP restrictions can
         be configured below when the hosting environment has a stable public IP. -->
    <add key="SuperUserRecoveryEnabled" value="true" />

<add key="SuperUserRecoveryKeyHash" value="PBKDF2$210000$QTTvi8oqZ6fFps9Yuxglpw==$W5Doa5E5qCro+Ho5i5zy+UGbugtlSSqnVs0dKzBdNZs=" />

    <!-- <add key="SuperUserRecoveryKeyHash" value="PASTE-HASH-FROM-THE-PAGE" /> -->
    <!--<add key="SuperUserRecoveryExpiresUtc" value="2026-11-02T18:00:00Z" />-->
   <!--<add key="SuperUserRecoveryAllowedIPs" value="203.0.113.10" />-->
    <!-- V10.24 Two-step sign-in (authenticator app). Set to false to switch the feature off without redeploying. -->
    <add key="TwoStepEnabled" value="true" />
    <!-- Leave blank to automatically play the newest MP3 in Content. Or enter a filename such as school-theme.mp3. -->
    <add key="VisitMusicFile" value="" />
    <!-- Enterprise Hybrid licensing: replace with the provider-issued RSA public key before production use. -->
    <add key="LicenseEnforcementEnabled" value="false" />
    <!-- V14: in-app SQL console is SELECT-only unless set to "false". Keep true in production. -->
    <add key="SqlConsoleReadOnly" value="true" />
    <add key="LicensePublicKeyXml" value="" />
  </appSettings>
  <!-- Database connection moved to external Database.config -->
<system.web>

    <compilation
        debug="false"
        targetFramework="4.8">
      <assemblies>
        <add assembly="System.IO.Compression, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.IO.Compression.FileSystem, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B77A5C561934E089" />
        <add assembly="System.Security, Version=4.0.0.0, Culture=neutral, PublicKeyToken=B03F5F7F11D50A3A" />
      </assemblies>
    </compilation>

    <httpRuntime
        targetFramework="4.8"
        requestValidationMode="4.5"
        enableVersionHeader="false"
        maxRequestLength="10240" />

    <pages
        controlRenderingCompatibilityVersion="4.0"
        clientIDMode="AutoID" />

    <globalization
        requestEncoding="utf-8"
        responseEncoding="utf-8"
        fileEncoding="utf-8"
        culture="en-IN"
        uiCulture="en-IN" />

    <!-- Version 10.15: hide raw ASP.NET errors from visitors and show a friendly fallback page. -->
    <customErrors
        mode="Remoteonly"
        defaultRedirect="Site-Under-Maintenance.html"
        redirectMode="ResponseRedirect" />

    <sessionState
        mode="InProc"
        cookieless="UseCookies"
        timeout="30"
        regenerateExpiredSessionId="true" />

    <authentication mode="Forms">
      <forms
          loginUrl="Login.aspx"
          timeout="30"
          slidingExpiration="true"
          cookieless="UseCookies"
          protection="All"
          requireSSL="true" />
    </authentication>

    <httpCookies
        httpOnlyCookies="true"
        requireSSL="true"
        sameSite="Lax" />

  </system.web>

  <system.webServer>

    <!-- V14 security headers. If the host rejects this block (HTTP 500), delete from here to the matching end comment. -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <!-- Report-only: observe first, then rename to Content-Security-Policy once nothing legitimate is flagged. -->
        <add name="Content-Security-Policy-Report-Only" value="default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'self'" />
      </customHeaders>
    </httpProtocol>
    <!-- end V14 security headers -->

    <!-- Optional HTTPS redirect (needs the IIS URL Rewrite module). Uncomment if your host has it.
    <rewrite>
      <rules>
        <rule name="HTTPS redirect" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{HTTP_HOST}" pattern="^localhost" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    -->

    <!-- Version 8.9: public landing page is the site default document. -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="Default.aspx" />
        <add value="index.html" />
      </files>
    </defaultDocument>


    <!-- Version 10.6: ensure IIS serves MP3 files with the correct MIME type. -->
    <staticContent>
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
    </staticContent>

    <!-- Version 10.15: IIS-level fallback for HTTP 500 errors.
         This also helps when an error occurs before ASP.NET can render its custom error page. -->
    <httpErrors
        errorMode="Custom"
        existingResponse="Replace">
      <remove statusCode="500" subStatusCode="-1" />
      <error statusCode="500"
             path="/Site-Under-Maintenance.html"
             responseMode="ExecuteURL" />
    </httpErrors>

    <!-- V10.30 speed: compress responses and let browsers keep /Content files for 7 days.
         Changed files carry ?v= version numbers, so updates still show. If the host rejects this block
         (HTTP 500), delete from here to the matching end comment. -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />
    <!-- end V10.30 speed block -->

  </system.webServer>

  <location path="Content">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

</configuration>





