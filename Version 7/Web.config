<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <connectionStrings>
    <!-- PRODUCTION: do NOT commit real credentials. Use environment variables or a secret store.
         Example (set via your host or CI):
         PayrollDb=Server=sql.example.com;Database=your_db;User ID=your_user;Password=YOUR_SECRET;TrustServerCertificate=False;
    -->
    <add name="PayrollDb"
         connectionString="Server=REPLACE_SERVER;Database=REPLACE_DATABASE;User ID=REPLACE_USER;Password=REPLACE_PASSWORD;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>

    <compilation
        debug="false"
        targetFramework="4.8" />

    <httpRuntime
        targetFramework="4.8"
        requestValidationMode="4.5" />

    <pages
        controlRenderingCompatibilityVersion="4.0"
        clientIDMode="AutoID" />

    <globalization
        requestEncoding="utf-8"
        responseEncoding="utf-8"
        fileEncoding="utf-8"
        culture="en-IN"
        uiCulture="en-IN" />

    <customErrors mode="Off" />

    <sessionState
        mode="InProc"
        cookieless="UseCookies"
        timeout="30"
        regenerateExpiredSessionId="true" />

    <authentication mode="Forms">
      <forms
          loginUrl="Login.aspx"
          timeout="30"
          slidingExpiration="true"
          cookieless="UseCookies"
          protection="All" />
    </authentication>

    <httpCookies
        httpOnlyCookies="true"
        requireSSL="true"
        sameSite="Lax" />

  </system.web>

  <system.webServer>

    <httpErrors
        errorMode="DetailedLocalOnly"
        existingResponse="PassThrough" />

  </system.webServer>

</configuration>
